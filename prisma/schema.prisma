// DPDP Privacy Admin — data model
//
// Runs on Postgres (hosted, via Vercel). The model was authored Postgres-shaped
// from the start and previously ran on SQLite for local development, which is
// why list columns are JSON strings named `...Json` (encoded and decoded via
// src/lib/codec/json.ts) and enums are plain String columns constrained by TS
// unions in src/lib/domain.ts rather than native Postgres types.
//
// Those choices are now merely conservative rather than necessary; they are left
// as they are because changing them would be a data migration with no user-facing
// benefit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Actors and principals
// ---------------------------------------------------------------------------

/// A human or service account. `role` gates what the guards will permit.
model Actor {
  id    String @id @default(cuid())
  name  String
  email String @unique
  /// admin | dpo | ciso | grievance_officer | system
  role  String

  confirmedExecutions ExecutionRecord[]          @relation("ExecutionConfirmedBy")
  reviewedExceptions  RetentionException[]       @relation("ExceptionReviewedBy")
  ruledEscalations    Escalation[]               @relation("EscalationRuledBy")
  checkedItems        VerificationChecklistItem[]
  auditEntries        AuditLogEntry[]
  assignedRequests    DataPrincipalRequest[]     @relation("RequestAssignee")
  notifications       Notification[]

  onboardingEscalationFor OnboardingState[] @relation("OnboardingEscalationContact")
  onboardingBackupFor     OnboardingState[] @relation("OnboardingBackupContact")
}

/// A Data Principal under the DPDP Act. Identifiers are separate rows so the
/// same human reached through several identifiers can be resolved to one
/// person, and so a conflict between candidate matches can be surfaced.
model DataPrincipal {
  id          String   @id @default(cuid())
  displayName String
  createdAt   DateTime @default(now())

  identifiers PrincipalIdentifier[]
  requests    DataPrincipalRequest[]
  locations   DataLocation[]
  exceptions  RetentionException[]
}

model PrincipalIdentifier {
  id          String  @id @default(cuid())
  principalId String
  /// email | phone | pan | customer_id | account_no
  kind        String
  value       String
  verified    Boolean @default(false)
  /// Which system asserted this identifier (free text; systems may be gone).
  assertedBy  String?

  principal DataPrincipal @relation(fields: [principalId], references: [id])

  @@index([kind, value])
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

model DataPrincipalRequest {
  id            String @id @default(cuid())
  referenceCode String @unique
  /// access | correction | erasure | nomination
  type          String
  /// received | identity_review | retention_review | executing | awaiting_confirmation | closed | rejected
  status        String

  principalId String?
  /// The identifier as the Data Principal supplied it, before resolution.
  rawIdentifier     String
  rawIdentifierKind String

  receivedAt DateTime
  /// Statutory fulfilment deadline, computed by the SLA engine.
  slaDeadline DateTime
  /// DPDP Rules 2025 Rule 8: notice at least 48h before erasure.
  preNoticeDueAt  DateTime?
  preNoticeSentAt DateTime?

  /// portal | grievance_officer | dpb | branch | email
  escalationSource      String
  linkedGrievanceCaseId String?

  /// Who is working this request. Needed for the "My assigned" filter; the
  /// auto-assignment engine from Scenario 10 would populate it, and until that
  /// exists the seed sets it directly.
  assignedToActorId String?

  /// Set when more than one DataPrincipal plausibly matches rawIdentifier.
  requiresIdentityReview Boolean @default(false)
  identityNote           String?

  notes String?

  assignedTo    Actor?               @relation("RequestAssignee", fields: [assignedToActorId], references: [id])
  principal     DataPrincipal?       @relation(fields: [principalId], references: [id])
  executions    ExecutionRecord[]
  exceptions    RetentionException[]
  escalations   Escalation[]
  notifications Notification[]

  @@index([status])
  @@index([slaDeadline])
}

// ---------------------------------------------------------------------------
// Where the data lives
// ---------------------------------------------------------------------------

model ConnectedSystem {
  id   String @id @default(cuid())
  name String @unique
  /// database | saas | archive | backup | crm
  kind String

  /// false means execution cannot be dispatched; routes to manual verification.
  hasApi Boolean
  /// healthy | degraded | down | manual_only
  connectionStatus String
  /// api | manual | delayed
  executionMode String
  /// For executionMode = delayed (e.g. backup rotation window), in days.
  delayDays Int?
  ownerTeam String

  /// Last time the connection was verified by a health check.
  lastVerifiedAt DateTime?
  /// JSON: [{ ok, detail?, at }] — health-check history, so a pattern over time
  /// is visible rather than only the current state.
  healthHistoryJson String @default("[]")

  locations  DataLocation[]
  executions ExecutionRecord[]
  accounts   SystemAccount[]
  mergeSteps MergeStep[]
  /// The scan-registry facet of the same real system. Connected Systems is a
  /// purpose-scoped view of that one registry, not a second list — see
  /// DiscoverySource.connectedSystem.
  source     DiscoverySource?
}

/// A Data Processor engaged under contract. DPDP s.8(2): the Data Fiduciary
/// remains responsible, so instructions must stay inside the DPA's scope.
model DataProcessor {
  id    String @id @default(cuid())
  name  String @unique
  dpaId String @unique
  /// JSON string[] of data categories the DPA actually covers.
  dpaScopeJson String
  /// email | portal | sftp
  contactChannel String
  dpaExpiresAt   DateTime?

  /// draft | active
  ///
  /// `draft` means the DPA is still being finalised. DPDP s.8(2) requires a
  /// valid contract before a Processor may process on the Fiduciary's behalf,
  /// so a draft processor is a HARD BLOCK on dispatch, not a warning — see
  /// guards/processorGate.ts.
  dpaStatus String @default("active")
  /// Optional at registration; JSON string[] of disclosed sub-processors.
  subProcessorsJson String @default("[]")

  /// low | medium | high — the vendor risk assessment, OWNED BY LEGAL /
  /// PROCUREMENT. Admin sees it for context but cannot edit it here; it is
  /// managed in the Governance Portal. Distinct governance source from DPO/CISO
  /// objects, same "visible, not editable" principle.
  riskClassification String?
  /// ISO country/region code of where the processor processes the data ("IN",
  /// "US", "EU"…). Governance-set, not Admin-editable. When it is outside India
  /// and not on the notified-country allowlist the activity row flags it
  /// "Cross-border — unreviewed" rather than failing silently. See lib/jurisdiction.
  jurisdiction String?
  /// The date the (active) DPA was executed.
  contractDate DateTime?

  // -- Health --------------------------------------------------------------
  /// responsive | degraded | unreachable
  healthStatus      String    @default("responsive")
  lastCheckedAt     DateTime?
  /// When the processor first became unreachable in the current outage. Drives
  /// the "unreachable for N hours" duration and the escalate-after-threshold.
  unreachableSinceAt DateTime?
  /// JSON: [{ ok, detail?, at }] — check history over time.
  healthHistoryJson String @default("[]")

  /// When the TPRM integration is on, a Privacy Processor record holds only a
  /// reference back to the TPRM Vendor — name, category, DPA and risk are pulled
  /// live via this id, never copied as editable Privacy-side fields.
  vendorId String?
  /// Genuinely Privacy-owned, processing-activity-specific detail captured at
  /// import (NOT vendor-level data): the contract scope and retention terms tied
  /// to this particular processing relationship.
  processorScope String?
  retentionTerms String?

  locations  DataLocation[]
  executions ExecutionRecord[]
  activityElements ActivityElement[]
  vendor     Vendor? @relation(fields: [vendorId], references: [id])
  flowNodes  DataFlowNode[]
  activityPurposes ActivityPurpose[] @relation("SegmentProcessor")
}

/// Discovered location of a principal's data. Exactly one of systemId or
/// processorId is set. `discoveredAt` and `stale` are what make coverage
/// completeness derivable instead of assumed.
model DataLocation {
  id          String  @id @default(cuid())
  principalId String
  systemId    String?
  processorId String?

  /// JSON string[] of data categories present here.
  dataCategoriesJson String
  recordCount        Int

  discoveredAt DateTime
  /// scan | catalog_import | questionnaire | manual
  discoverySource String
  /// true means this location's inventory is out of date; blocks "verified".
  stale Boolean @default(false)

  principal DataPrincipal    @relation(fields: [principalId], references: [id])
  system    ConnectedSystem? @relation(fields: [systemId], references: [id])
  processor DataProcessor?   @relation(fields: [processorId], references: [id])

  @@index([principalId])
}

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------

/// One unit of work against one system or one processor.
///
/// NOTE: there is deliberately no boolean "done" column anywhere in this
/// schema. Request-level completion is DERIVED from these rows by
/// src/lib/engines/completion.ts and is always three-state.
model ExecutionRecord {
  id        String @id @default(cuid())
  requestId String

  systemId    String?
  processorId String?

  /// api | manual | delayed | processor_instruction
  mode String
  /// pending | partial | verified | failed
  status String

  /// JSON string[] of field paths withheld under a retention exception.
  /// A non-empty value means this was a partial, field-level deletion.
  excludedFieldsJson String @default("[]")

  /// For delayed execution (backup rotation).
  scheduledFor DateTime?
  dispatchedAt DateTime?
  /// Processor instructions: when the instruction was acknowledged as received.
  deliveredAt        DateTime?
  confirmedAt        DateTime?
  confirmedByActorId String?

  /// api_ack | manual_attestation | processor_confirmation
  verificationMethod String?

  /// Diagnostics are stored in full and shown to Admin. The role responsible
  /// for fixing the failure needs to see why it failed.
  failureCode        String?
  failureDetail      String?
  failureRawResponse String?
  attempt            Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request     DataPrincipalRequest       @relation(fields: [requestId], references: [id])
  system      ConnectedSystem?           @relation(fields: [systemId], references: [id])
  processor   DataProcessor?             @relation(fields: [processorId], references: [id])
  confirmedBy Actor?                     @relation("ExecutionConfirmedBy", fields: [confirmedByActorId], references: [id])
  checklist   VerificationChecklistItem[]

  @@index([requestId])
  @@index([status])
}

/// Checklist backing the Manual Verification Panel for non-API systems.
model VerificationChecklistItem {
  id                String    @id @default(cuid())
  executionRecordId String
  label             String
  ordinal           Int
  checked           Boolean   @default(false)
  checkedAt         DateTime?
  checkedByActorId  String?
  note              String?

  executionRecord ExecutionRecord @relation(fields: [executionRecordId], references: [id])
  checkedBy       Actor?          @relation(fields: [checkedByActorId], references: [id])

  @@index([executionRecordId])
}

// ---------------------------------------------------------------------------
// Retention and escalation
// ---------------------------------------------------------------------------

/// A statutory obligation to KEEP data, which overrides an erasure request for
/// the fields it covers (DPDP s.8(7) proviso). Scoped to field paths so
/// deletion can be partial rather than all-or-nothing.
model RetentionException {
  id          String  @id @default(cuid())
  principalId String
  requestId   String?

  dataCategory String
  /// JSON string[] of field paths protected by this obligation.
  fieldPathsJson String
  legalBasis     String
  /// Human-readable citation, e.g. "PMLA 2002 s.12 r/w PML Rules r.3".
  statuteRef      String
  expiryCondition String
  expiresAt       DateTime?

  /// unreviewed | acknowledged | override_requested | overridden | upheld
  /// Execution is blocked while ANY exception for the principal is unreviewed.
  reviewStatus String  @default("unreviewed")
  autoFlagged  Boolean @default(true)

  reviewedByActorId String?
  reviewedAt        DateTime?

  principal   DataPrincipal         @relation(fields: [principalId], references: [id])
  request     DataPrincipalRequest? @relation(fields: [requestId], references: [id])
  reviewedBy  Actor?                @relation("ExceptionReviewedBy", fields: [reviewedByActorId], references: [id])
  escalations Escalation[]

  @@index([principalId])
  @@index([reviewStatus])
}

/// Admin cannot resolve a legal or policy conflict alone. Overriding a
/// retention exception requires an Escalation carrying a DPO ruling; the guards
/// refuse to let an admin-role actor write `ruling`.
model Escalation {
  id                   String  @id @default(cuid())
  requestId            String?
  retentionExceptionId String?

  /// admin | dpo | ciso | grievance_officer
  sourceRole String
  targetRole String
  /// retention_conflict | policy_ambiguity | rule_request | rule_exception |
  /// purpose_request | dpa_update | other
  ///
  /// One object, many sources: every escalation-creating action across the
  /// product produces this same shape, distinguished by `type` — not five
  /// bespoke mechanisms.
  type       String @default("other")
  /// Human reference, e.g. ESC-2026-0031. Null on runtime-created ones, which
  /// the UI renders from the id instead.
  referenceCode String?
  reason     String
  /// JSON snapshot of the state at escalation time.
  contextJson String
  /// JSON string[] of audit-entry ids and execution ids attached as evidence.
  attachedEvidenceJson String @default("[]")

  /// open | ruled | withdrawn
  status String @default("open")
  /// approve_override | uphold_retention | partial_override
  ruling          String?
  rulingRationale String?
  ruledByActorId  String?
  ruledAt         DateTime?

  createdAt DateTime @default(now())

  request   DataPrincipalRequest? @relation(fields: [requestId], references: [id])
  exception RetentionException?   @relation(fields: [retentionExceptionId], references: [id])
  ruledBy   Actor?                @relation("EscalationRuledBy", fields: [ruledByActorId], references: [id])

  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit and notification (written by engines only)
// ---------------------------------------------------------------------------

/// Append-only, hash-chained. There is no update or delete path for this model
/// anywhere in the codebase.
///
/// `targetId` is a plain String, NOT a foreign key. Erasing the underlying
/// personal data must never erase the record that it was erased.
model AuditLogEntry {
  /// `seq` is the primary key: for an append-only chained log the sequence
  /// number IS the natural identity, and SQLite only allows autoincrement on
  /// the id column. Portable to Postgres (serial).
  seq       Int      @id @default(autoincrement())
  id        String   @unique @default(cuid())
  timestamp DateTime @default(now())

  actorId    String?
  actorLabel String
  actorRole  String

  action     String
  targetType String
  targetId   String
  requestId  String?

  payloadJson String
  evidenceRef String?

  /// sha256 over the canonicalised entry, chained to the previous entry.
  payloadHash String
  prevHash    String

  actor Actor? @relation(fields: [actorId], references: [id])

  @@index([requestId])
  @@index([targetType, targetId])
  @@index([action])
}

/// Cross-persona notification. Written by the notification engine as a
/// consequence of a state change, never by a screen. There is no "notify"
/// action anywhere in the Admin UI.
model Notification {
  id            String @id @default(cuid())
  targetRole    String
  targetActorId String?
  triggerEvent  String
  title         String
  body          String
  requestId     String?
  /// info | warning | critical
  severity  String    @default("info")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  targetActor Actor?                @relation(fields: [targetActorId], references: [id])
  request     DataPrincipalRequest? @relation(fields: [requestId], references: [id])

  @@index([targetRole])
}

// ---------------------------------------------------------------------------
// Governance-owned objects — READ-ONLY to Admin.
//
// These are created and approved in the DPO / CISO modules, which do not exist
// in this build. They are populated by the seed only: no create, update or
// delete function is written for them anywhere in src/. Read-only is enforced
// by the absence of mutation code, not by a disabled button.
// ---------------------------------------------------------------------------

model PurposeTag {
  id          String @id @default(cuid())
  name        String @unique
  description String
  /// draft | approved | retired | pending_dpo_approval | rejected
  ///
  /// A purpose Admin proposes (no existing one fits) is created
  /// `pending_dpo_approval` and routed to the DPO Approval Queue — it never
  /// appears in Approved Policy or the existing-purpose picker until ratified.
  status     String
  approvedBy String
  approvedAt DateTime

  /// Proposal provenance — set when Admin proposes a new purpose for an element.
  proposedBy      String?
  proposedAt      DateTime?
  /// The element this purpose was proposed for, so the DPO has the context on
  /// why it is needed. Plain id (not an FK cascade) — kept for audit even if the
  /// element changes.
  linkedElementId String?
  /// Recorded when the DPO rejects the proposal; the purpose is not shown in
  /// Approved Policy in that state.
  rejectionReason String?
  /// True when approved under combined_admin_dpo governance (the requester and the
  /// approver are the same person). System-computed at approval, never user-set,
  /// and never relabelled if the org later designates a dedicated DPO.
  selfApproved Boolean @default(false)

  /// Retention belongs to the PURPOSE, not the element or activity: the same
  /// element used for two purposes carries two retention clocks, so retention
  /// travels with the purpose. A duration ("365 days") or "until deletion".
  /// DPO-set at approval time; Admin sees it locked, like the purpose itself.
  retention  String?
  /// consent | legitimate_use | contractual — the lawful basis under the DPDP
  /// Act for processing under this purpose. DPO-set; shown beside the purpose.
  lawfulBasis String?

  classifiedFields   ClassifiedField[]
  processingActivities ProcessingActivity[]
  consentRecords     ConsentRecord[]
  dataFlowConnections DataFlowConnection[]
  notices            Notice[] @relation("NoticePurpose")
  activityElements   ActivityElement[] @relation("ElementPurpose")
  vendorMappings     VendorPurposeMapping[] @relation("VendorPurpose")
  ropaSuggestions    RopaSuggestion[]
  activityPurposes   ActivityPurpose[] @relation("SegmentPurpose")
}

/// A record of processing activity, entered by hand for data no scanner can
/// reach. Activity / Purpose / Data elements / Subject type are columns of one
/// record, not steps in a wizard — the earlier 4-step questionnaire was the
/// wrong shape for structured tabular data.
model ProcessingActivity {
  id       String @id @default(cuid())
  activity String

  /// FK to the DPO-approved taxonomy — the same policy-locked source the
  /// classification review uses. Never free text.
  purposeTagId String?
  /// customer | employee | vendor | minor
  subjectType  String?
  /// JSON string[] of data-element tags. A tag may match an inventory field
  /// name or be free text that is flagged as not-yet-in-inventory.
  dataElementsJson String @default("[]")

  createdAt DateTime @default(now())
  /// csv | manual | ropa_suggested — how the row first entered the table.
  origin    String   @default("manual")
  /// Optional plain-English description captured in the Add Activity modal.
  description String?

  /// active | under_review | archived. Admin sets active/under_review directly;
  /// moving to archived routes a DPO-approval request (the same escalation
  /// pattern as Purpose/Processor) and is blocked while any element is still
  /// "requested — awaiting DPO".
  lifecycleState String @default("active")

  /// The Fiduciary registry entry (Entity) this activity belongs to. Links to
  /// the Fiduciaries tab's data — never a parallel entity list. Nullable: an
  /// activity with no entity shows "Unassigned entity" and still functions.
  entityId String?

  purposeTag PurposeTag? @relation(fields: [purposeTagId], references: [id])
  entity     Entity?     @relation(fields: [entityId], references: [id])
  elements   ActivityElement[]
  purposeSegments ActivityPurpose[]

  @@index([purposeTagId])
  @@index([entityId])
}

/// PURPOSE-FIRST STRUCTURE. A purpose segment under an activity: you declare WHY
/// (the purpose) before WHAT (the elements). Retention + legal basis come from the
/// referenced PurposeTag (DPO-owned); the Processor now lives HERE, per purpose,
/// not on the element. `purposeTagId` null = "Decide later" (segment exists, no
/// purpose chosen yet). `requestState` = requested while a proposed purpose (or
/// its processor) awaits the DPO.
model ActivityPurpose {
  id         String @id @default(cuid())
  activityId String
  purposeTagId String?
  processorId  String?
  /// none | requested
  requestState String @default("none")
  /// True when the segment's purpose was approved under combined_admin_dpo
  /// governance. System-computed; permanent historical marker.
  selfApproved Boolean @default(false)
  createdAt    DateTime @default(now())

  activity   ProcessingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  purposeTag PurposeTag?        @relation("SegmentPurpose", fields: [purposeTagId], references: [id])
  processor  DataProcessor?     @relation("SegmentProcessor", fields: [processorId], references: [id])
  elements   ActivityPurposeElement[]

  @@index([activityId])
  @@index([purposeTagId])
}

/// The many-to-many linkage of a data field UNDER a purpose segment. The same
/// field (e.g. PAN Number) can be linked under multiple purposes in one activity —
/// each linkage is its own row, independently removable, and carries its purpose's
/// own retention/processor.
model ActivityPurposeElement {
  id String @id @default(cuid())
  activityPurposeId String
  /// The field name (also the Data Inventory field path when linked to one).
  fieldName String
  classifiedFieldId String?
  createdAt DateTime @default(now())

  activityPurpose ActivityPurpose @relation(fields: [activityPurposeId], references: [id], onDelete: Cascade)

  @@index([activityPurposeId])
}

/// One PII element within a Processing Activity. Purpose and Processor attach
/// HERE, at the element level — not once per activity — because "Loan
/// Application" legitimately uses PAN for KYC (no processor) and Phone for
/// marketing (an SMS processor) at the same time. Admin never sets Purpose
/// directly: an unassigned element routes a bundled Purpose+Processor request to
/// the DPO (requestState = requested) rather than a free-text create.
model ActivityElement {
  id          String  @id @default(cuid())
  activityId  String
  elementName String
  /// FK to the DPO-approved taxonomy (policy-locked). Null = unassigned.
  purposeTagId String?
  /// The processor this element's data is shared with. Null = internal only.
  processorId  String?
  /// customer | employee | vendor | minor
  subjectType String?
  /// none | requested — a bundled Purpose+Processor request is pending DPO.
  requestState String @default("none")

  createdAt DateTime @default(now())

  activity   ProcessingActivity @relation(fields: [activityId], references: [id])
  purposeTag PurposeTag?        @relation("ElementPurpose", fields: [purposeTagId], references: [id])
  processor  DataProcessor?     @relation(fields: [processorId], references: [id])

  @@index([activityId])
}

model NoticeVersion {
  id      String @id @default(cuid())
  version String @unique
  title   String
  content String
  /// JSON string[] of region codes.
  publishedRegionsJson String
  /// JSON string[] of Eighth Schedule language codes (DPDP s.5(3)).
  languagesJson String
  status        String
  approvedBy    String
  approvedAt    DateTime
}

model CookieCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String
  /// on | off — default consent state; strictly necessary is the only `on`.
  defaultState String
  approvedBy   String
  approvedAt   DateTime

  scripts CookieScript[]
}

// ---------------------------------------------------------------------------
// Consent & Notices — Admin's implementation layer.
//
// The CATEGORY policy (above) and the purpose taxonomy stay governance-owned.
// What Admin owns here is the technical implementation: publishing notices to
// regions, mapping scripts to approved categories, wiring webhooks, and
// recording consent artifacts. None of these are in the governance-read-only
// set — they are Admin's job.
// ---------------------------------------------------------------------------

/// A privacy notice as Admin publishes it. Content is drafted and published
/// here; the approved substance is the DPO's, but the implementation — region
/// assignment, language variants, versioning — is Admin's.
model Notice {
  id     String @id @default(cuid())
  name   String
  /// draft | published | retired
  status String @default("draft")

  content        String @default("")
  currentVersion String @default("v1.0")
  /// template | import | scratch
  origin String @default("scratch")

  /// The Fiduciary this notice belongs to. Required in the UI; nullable in the
  /// schema so full tenant isolation can be layered on once multi-tenancy is
  /// resolved (business unit vs. separate client org) without a data migration.
  fiduciaryId String?
  /// Controlled data category (src/lib/domain DataCategory) — never free text,
  /// which is what let production drift PERSONAL_DATA vs PERSONAL_INFORMATION.
  dataCategory String?
  /// FK into the DPO-approved purpose taxonomy — the same policy-locked source
  /// every other purpose reference in this product uses.
  purposeTagId String?

  /// JSON string[] of region codes this notice is published to.
  regionsJson String @default("[]")
  /// Notify existing users when this notice changes (Publish Settings).
  notifyOnChange Boolean @default(false)

  /// Manual Rule 3 confirmations, keyed by item, each with the required note
  /// explaining where the requirement is met (e.g. a global footer link). The
  /// three link checks auto-detect from the body; this covers overrides and the
  /// two prose statements. See src/lib/notices.ts.
  rule3ManualJson String @default("{}")

  /// Publish is DPO-gated, matching every other governance object. Admin can
  /// only submit; the transition itself is a DPO action.
  /// none | pending_publish | pending_unpublish
  approvalState      String  @default("none")
  /// Payload staged with a pending publish request, applied on DPO approval.
  pendingRegionsJson String?
  pendingNotify      Boolean @default(false)
  submittedBy        String?
  submittedAt        DateTime?

  /// Retired is a terminal state a live notice moves INTO once superseded — a
  /// draft was never live, so the two are not the same. Retiring records what
  /// replaced it, so the historical record is navigable.
  retiredAt      DateTime?
  supersededById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fiduciary    Entity?     @relation(fields: [fiduciaryId], references: [id])
  purposeTag   PurposeTag? @relation("NoticePurpose", fields: [purposeTagId], references: [id])
  supersededBy Notice?     @relation("NoticeSupersession", fields: [supersededById], references: [id])
  supersedes   Notice[]    @relation("NoticeSupersession")

  revisions NoticeRevision[]
  variants  NoticeVariant[]

  @@index([fiduciaryId])
}

/// One point in a notice's version history. Editing and history are the same
/// object at different times, so they live together rather than in split tabs.
model NoticeRevision {
  id       String @id @default(cuid())
  noticeId String
  version  String
  content  String
  note     String?
  savedBy  String
  savedAt  DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id])

  @@index([noticeId])
}

/// Per-language content. `language` is an Eighth Schedule code (DPDP s.5(3)).
model NoticeVariant {
  id       String @id @default(cuid())
  noticeId String
  language String
  content  String @default("")

  notice Notice @relation(fields: [noticeId], references: [id])

  @@unique([noticeId, language])
}

// ---------------------------------------------------------------------------
// Vendor Risk (TPRM) — the Fiduciary's relationship with every vendor and
// sub-processor who touches personal data on its behalf. Governance authority
// (final risk classification, DPA sign-off) stays with Legal/DPO; the vendor
// carries the disclosure and evidence obligations.
// ---------------------------------------------------------------------------

/// The single source of truth for a vendor relationship — replacing the
/// spreadsheet-and-Drive-folder it lived in. Risk rating has a system-suggested
/// BASELINE (by category) and a final rating a human owns; every manual override
/// of the baseline is logged with who/from/to/why (riskOverrideHistoryJson).
model Vendor {
  id       String @id @default(cuid())
  name     String @unique
  category String

  /// low | medium | high | critical — the final, human-owned rating.
  riskRating String
  /// low | medium | high | critical — the system suggestion by category.
  riskBaseline String
  /// [{ from, to, by, reason, at }] — audit of every manual override.
  riskOverrideHistoryJson String @default("[]")

  ownerName      String?
  onboardedAt    DateTime?
  lastReviewedAt DateTime?

  // DPA & contract
  dpaName    String?
  dpaScope   String?
  dpaSignedAt  DateTime?
  dpaExpiresAt DateTime?
  /// active | expired | not_on_file — "expiring" is DERIVED from dpaExpiresAt
  /// proximity, never stored, so it can never go stale.
  dpaStatus String @default("not_on_file")
  dpaDocLink String?

  createdAt DateTime @default(now())

  purposeMappings VendorPurposeMapping[]
  assessments     VendorAssessment[]
  subProcessorDisclosures SubProcessorDisclosure[]
  documents       SubProcessorDocument[]
  processors      DataProcessor[]
  portalAccess    VendorPortalAccess?
}

// ---------------------------------------------------------------------------
// TPRM Configuration — the hardcoded templates and baseline logic in
// src/lib/tprm.ts, lifted into editable, policy-locked (DPO/Legal) storage.
// Seeded from the same defaults, so day-one behaviour is unchanged.
// ---------------------------------------------------------------------------

model QuestionnaireTemplate {
  id          String  @id @default(cuid())
  name        String
  /// comma-separated Risk values (low,medium,high,critical) this template fits.
  forTiers    String
  description String
  active      Boolean @default(true)
  createdAt   DateTime @default(now())

  questions TemplateQuestion[]
}

model TemplateQuestion {
  id         String @id @default(cuid())
  templateId String
  section    String
  label      String
  sortOrder  Int

  template QuestionnaireTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId])
}

/// Category → baseline-risk rules. First match wins (sortOrder ascending), the
/// same precedence the old if/else chain in baselineForCategory relied on.
model RiskAppetiteRule {
  id              String @id @default(cuid())
  categoryPattern String
  baselineRating  String
  sortOrder       Int
}

/// An AI-suggested RoPA register entry: a grouping of approved ClassifiedField
/// rows by (source, purpose, subject type). A read+review layer over data that
/// already exists — accepting one creates a real ProcessingActivity; a re-run
/// never resurrects an accepted/dismissed grouping unless its field set changes.
model RopaSuggestion {
  id              String @id @default(cuid())
  sourceId        String
  purposeTagId    String?
  dataSubjectType String?
  /// JSON string[] of ClassifiedField ids that make up this grouping.
  fieldIdsJson    String @default("[]")
  generatedAt     DateTime @default(now())
  /// pending | accepted | dismissed
  status          String @default("pending")
  dismissedReason String?
  /// The ProcessingActivity created when accepted.
  activityId      String?

  source     DiscoverySource @relation(fields: [sourceId], references: [id])
  purposeTag PurposeTag?     @relation(fields: [purposeTagId], references: [id])

  @@index([status])
  @@index([sourceId])
}

/// Platform integration flags (singleton). When `tprmEnabled` is on, Vendors are
/// created and managed only in TPRM, and Privacy's Processor records import a
/// reference (Vendor ID) instead of creating vendor-level data of their own.
model IntegrationConfig {
  id          String  @id @default("singleton")
  tprmEnabled Boolean @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

/// Data-Processor portal access, provisioned FROM the TPRM Vendor record — one
/// login per real-world vendor (the @unique on vendorId enforces exactly that).
/// Multiple named users are a Vendor-scoped grant, never separate logins.
model VendorPortalAccess {
  id            String   @id @default(cuid())
  vendorId      String   @unique
  contactName   String
  email         String
  /// string[] of Processor record ids / purposes this access may see.
  scopeJson     String   @default("[]")
  provisionedAt DateTime @default(now())
  provisionedBy String?

  vendor Vendor @relation(fields: [vendorId], references: [id])
}

/// A vendor's disclosure that it wants to bring in its own subcontractor to touch
/// the Fiduciary's data. The lifecycle is FOUR states, not the usual three: the
/// extra `held_pending_approval` is a genuine system-enforced block — there is no
/// processor-side action anywhere that can move a disclosure to `active`; only a
/// Legal/DPO approval can. `flagged` records are the detector's output: a transfer
/// seen on the flow map that matches no registered disclosure.
model SubProcessorDisclosure {
  id               String @id @default(cuid())
  primaryVendorId  String
  subProcessorName String
  scope            String  @default("")
  reason           String?
  /// string[] of PII categories the sub-processor will touch — the fields the
  /// undisclosed-transfer detector checks a flagged flow against.
  piiTypesJson     String  @default("[]")

  /// draft | pending_disclosure | held_pending_approval | active | flagged
  status String @default("draft")

  disclosedAt    DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedReason String?

  // Detection (Screen 3.4) — set on records the detector raised, not the vendor.
  detected        Boolean   @default(false)
  firstDetectedAt DateTime?
  /// under_investigation | routed_to_legal | resolved — the flag's routing state.
  flagStatus      String?

  createdAt DateTime @default(now())

  primaryVendor Vendor                 @relation(fields: [primaryVendorId], references: [id])
  documents     SubProcessorDocument[]

  @@index([primaryVendorId])
  @@index([status])
}

/// A compliance document. Attached to a disclosure (Screen 3.2 Step 3) AND, via
/// the same records, populating the vendor's standing Evidence Package Store
/// (Screen 3.6) — one upload mechanism, two surfaces, never two.
model SubProcessorDocument {
  id           String  @id @default(cuid())
  vendorId     String
  disclosureId String?
  name         String
  /// certification | dpa | security | other
  docType   String @default("other")
  expiresAt DateTime?
  uploadedAt DateTime @default(now())

  vendor     Vendor                  @relation(fields: [vendorId], references: [id])
  disclosure SubProcessorDisclosure? @relation(fields: [disclosureId], references: [id])

  @@index([vendorId])
  @@index([disclosureId])
}

/// A vendor's risk-assessment lifecycle: baseline (by category) → questionnaire
/// assigned → vendor responds → Legal reviews and sets the FINAL classification,
/// written back to the Vendor. The baseline is a starting suggestion for the
/// questionnaire's rigor, never a substitute for the human review.
model VendorAssessment {
  id           String   @id @default(cuid())
  vendorId     String
  templateName String
  assignedAt   DateTime @default(now())

  /// not_started | in_progress | submitted — the vendor's side.
  vendorStatus String @default("not_started")
  /// pending | partial | verified — Legal's three-state review.
  legalReviewStatus String @default("pending")

  /// low | medium | high | critical — the final classification, once verified.
  classification       String?
  classificationReason String?
  /// The system-suggested baseline captured at assignment time.
  baselineRating String

  submittedAt DateTime?
  /// The vendor's answers: { questionId: answerText }.
  responseJson String @default("{}")

  createdAt DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

/// One Purpose → PII-types → processing-activity row for a vendor. This is the
/// query surface that makes "which vendors touch Aadhaar" answerable without a
/// manual contract trace.
model VendorPurposeMapping {
  id           String  @id @default(cuid())
  vendorId     String
  purposeTagId String?
  purposeName  String
  /// string[] of PII categories handled for this purpose.
  piiTypesJson String  @default("[]")
  activityName String?

  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  purposeTag PurposeTag? @relation("VendorPurpose", fields: [purposeTagId], references: [id])

  @@index([vendorId])
}

/// A saved "My Dashboard" layout. Keyed by ROLE, not by person: customization
/// reuses the "Acting as" switcher, so a DPO and an Admin get different default
/// dashboards, matching how per-role configuration works everywhere else here.
/// `widgetsJson` is a JSON array of { id, size } — the Tier-2/Tier-3 widgets the
/// role has added, in order. Tier-1 widgets are never stored: they are pinned on
/// Operations regardless and are not customization candidates.
model DashboardLayout {
  role        String   @id
  widgetsJson String   @default("[]")
  updatedAt   DateTime @updatedAt
}

/// A third-party script mapped to a cookie category. The category and its
/// default state are policy-locked; the mapping is the one thing Admin edits.
model CookieScript {
  id         String @id @default(cuid())
  name       String
  vendor     String?
  page       String?
  categoryId String?

  category CookieCategory? @relation(fields: [categoryId], references: [id])
}

/// A finding from a cookie compliance scan. Structurally the same "flagged item
/// needing a decision" as a low-confidence field, so the triage drawer is
/// reused rather than a new pattern built.
model CookieScanFinding {
  id         String @id @default(cuid())
  scriptName String
  vendor     String?
  page       String
  /// true = declared in the cookie policy; false = undisclosed, needs a call.
  disclosed  Boolean
  /// open | categorised | blocked | dismissed
  status     String @default("open")
  suggestedCategory String?
  firstSeen  DateTime @default(now())
}

/// A webhook endpoint. A real table with an inline add row and a test action,
/// not a modal form.
model Webhook {
  id       String @id @default(cuid())
  endpoint String
  /// consent.granted | consent.withdrawn | consent.expired | notice.published
  event    String
  /// active | paused | failing
  status   String @default("active")
  lastTestAt     DateTime?
  lastTestResult String?

  createdAt DateTime @default(now())
}

/// A consent artifact. One model across every channel — digital, bulk import,
/// and branch/assisted — distinguished by `channelOrigin`, exactly as Requests
/// treats assisted submissions as a tag on one list rather than a parallel
/// data model.
model ConsentRecord {
  id         String @id @default(cuid())
  subjectRef String
  purposeTagId String?
  /// digital | bulk_import | branch | phone
  channelOrigin String
  /// granted | withdrawn | expired
  status String @default("granted")

  /// Immutability hash over the artifact (MeitY Electronic Consent Framework).
  artifactHash String?
  collectedAt  DateTime @default(now())
  expiresAt    DateTime?

  /// For assisted/offline capture: pending | synced | failed.
  syncStatus String @default("synced")
  /// Branch capture: how identity was verified in person.
  idVerification String?

  purposeTag PurposeTag? @relation(fields: [purposeTagId], references: [id])

  @@index([channelOrigin])
  @@index([syncStatus])
}

/// Singleton configuration for the consent platform's Setup tab.
model ConsentApiConfig {
  id String @id @default("singleton")

  apiEndpoint        String @default("")
  preferenceCenterBrand String @default("")
  /// Whether business units are isolated from one another.
  businessUnitIsolation Boolean @default(false)
  /// Default consent validity in months, for the expiry rule builder.
  defaultExpiryMonths Int @default(24)
}

model ProtectionRule {
  id           String @id @default(cuid())
  /// Human name, e.g. "PAN masking — customer-facing views". CISO-owned.
  ruleName     String @default("")
  dataCategory String
  /// mask | encrypt | dlp
  ruleType   String
  /// high | medium | low
  strictness String @default("high")
  scope      String
  definition String
  approvedBy String
  approvedAt DateTime
}

// ---------------------------------------------------------------------------
// Scenario 2 — Access Lifecycle & Identity Hygiene
//
// Internal staff access to the systems that hold personal data. Distinct from
// DataPrincipal: these are the people processing the data, not the people the
// data is about. Over-broad or lingering access is itself a DPDP exposure —
// s.8(4) requires reasonable security safeguards — so this is Admin's technical
// work, executed against a baseline the CISO approved.
// ---------------------------------------------------------------------------

/// A member of staff or a service identity that holds accounts on systems.
model InternalUser {
  id         String    @id @default(cuid())
  fullName   String
  email      String    @unique
  department String
  /// active | on_notice | offboarded
  employmentStatus String
  joinedAt   DateTime
  leftAt     DateTime?
  /// Set when HR flags an offboarding; drives the deprovisioning queue.
  offboardingDueAt DateTime?

  accounts SystemAccount[]
}

/// One account belonging to one InternalUser on one ConnectedSystem.
model SystemAccount {
  id       String @id @default(cuid())
  userId   String
  systemId String

  username String
  /// active | disabled | revoked | orphaned
  status   String
  createdAt    DateTime
  lastActiveAt DateTime?

  user   InternalUser    @relation(fields: [userId], references: [id])
  system ConnectedSystem @relation(fields: [systemId], references: [id])

  grants      AccessGrant[]
  sessions    ActiveSession[]
  revocations RevocationRecord[]
  disposition AccountDisposition?

  @@unique([systemId, username])
  @@index([userId])
  @@index([status])
}

/// A role held on an account, plus the data scope it reaches. Scope is what
/// makes least privilege checkable rather than aspirational: a grant that
/// reaches data categories the role template does not need is over-broad.
model AccessGrant {
  id        String @id @default(cuid())
  accountId String
  roleId    String

  /// JSON string[] of data categories this grant can actually reach.
  scopeCategoriesJson String
  grantedAt      DateTime
  grantedByActorId String?
  expiresAt      DateTime?
  revokedAt      DateTime?

  account SystemAccount @relation(fields: [accountId], references: [id])
  role    RBACRole      @relation(fields: [roleId], references: [id])

  @@index([accountId])
}

/// A live session or issued token. Revoking a grant does not end a session that
/// is already running, which is exactly how access survives deprovisioning.
model ActiveSession {
  id        String @id @default(cuid())
  accountId String

  /// session | api_token | refresh_token
  kind      String
  tokenRef  String
  startedAt DateTime
  lastSeenAt DateTime
  expiresAt  DateTime?
  terminatedAt DateTime?
  terminatedByActorId String?

  account SystemAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

/// Per-system record of a revocation attempt.
///
/// Deliberately mirrors ExecutionRecord: revoking access across N systems is
/// the same three-state problem as erasing data across N systems, and gets the
/// same treatment. There is no boolean "revoked" column.
model RevocationRecord {
  id        String @id @default(cuid())
  accountId String
  /// Groups the per-account records raised by one deprovisioning action.
  batchId   String

  /// pending | partial | verified | failed
  status String
  /// api | manual
  mode   String

  grantsRevoked   Int @default(0)
  sessionsKilled  Int @default(0)
  /// Sessions still live after the attempt — the usual reason a revocation is
  /// only partial.
  sessionsRemaining Int @default(0)

  dispatchedAt DateTime?
  confirmedAt  DateTime?
  confirmedByActorId String?
  verificationMethod String?

  failureCode        String?
  failureDetail      String?
  failureRawResponse String?
  attempt            Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account SystemAccount @relation(fields: [accountId], references: [id])

  @@index([batchId])
  @@index([status])
}

/// The outcome of investigating a dormant or orphaned account. Justification is
/// mandatory — "disabled it because it looked unused" is not a record anyone can
/// rely on later.
model AccountDisposition {
  id        String @id @default(cuid())
  accountId String @unique

  /// retain | disable | revoke | transfer_owner
  disposition   String
  justification String
  decidedByActorId String?
  decidedAt     DateTime @default(now())

  account SystemAccount @relation(fields: [accountId], references: [id])
}

// ---------------------------------------------------------------------------
// Declared now so migrations stay stable for scenarios 3-10.
// No screens are built against these in this pass.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// First-run onboarding
//
// Structure: a reordered linear wizard with ONE mandatory, non-skippable first
// step. Screen 1 configures escalation routing and surfaces the statutory
// retention categories — the two things that, left unconfigured, would let a
// deletion run with nowhere to escalate and no retention check. Everything
// after it is deferrable, because deferring it is visible and recoverable.
// ---------------------------------------------------------------------------

/// Single-tenant, so a single row. `id` defaults to "singleton" and the code
/// always upserts on that key: onboarding state is a property of the
/// installation, not of a user, and two Admins should not each get their own
/// half-finished wizard.
model OnboardingState {
  id String @id @default("singleton")

  currentStep Int       @default(1)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// JSON map of step number to "done" | "skipped". Skipped steps resurface on
  /// the dashboard until resolved, so deferral stays visible.
  stepStatusJson String @default("{}")

  // -- Screen 1: escalation and retention defaults ------------------------
  escalationContactActorId String?
  backupContactActorId     String?
  /// Entity this routing applies to, for multi-entity orgs. Null = primary.
  scopedEntityId String?

  /// Set only when the Governance Portal could not be reached and Admin
  /// explicitly acknowledged proceeding without it. Audit-logged.
  governanceUnavailableAcknowledged Boolean @default(false)
  /// True when Admin confirmed having seen the statutory categories — including
  /// the case where the list was empty, which is a risk, not a pass.
  retentionCategoriesAcknowledged Boolean @default(false)

  escalationContact Actor? @relation("OnboardingEscalationContact", fields: [escalationContactActorId], references: [id])
  backupContact     Actor? @relation("OnboardingBackupContact", fields: [backupContactActorId], references: [id])
}

/// Statutory retention categories, DPO-defined. Governance-owned: rendered with
/// the policy-lock treatment and never editable from Admin.
model RetentionCategory {
  id              String @id @default(cuid())
  name            String @unique
  retentionPeriod String
  statuteRef      String
  description     String @default("")
  approvedBy      String
  approvedAt      DateTime
}

/// Event-type notification routing, configured in Screen 6 and consumed by the
/// notification engine.
model NotificationRoute {
  id            String @id @default(cuid())
  eventType     String @unique
  recipientRole String
  /// in_app | email | sms
  channel       String
  /// Custom event types have no sensible default, so they must be assigned
  /// explicitly rather than left silently unrouted.
  isCustom      Boolean   @default(false)
  configuredAt  DateTime?
}

/// One field surfaced by a discovery scan, awaiting classification review.
model ClassifiedField {
  id       String @id @default(cuid())
  sourceId String

  fieldPath    String
  detectedType String
  /// high | needs_review
  confidence   String
  /// Sample value, already masked. The real value is never stored here.
  maskedSample String

  /// pending | approved | overridden
  reviewState    String  @default("pending")
  overriddenType String?
  overrideReason String?
  /// True when Admin overrode a field the system marked HIGH confidence. Logged
  /// distinctly from an ordinary needs-review override, because it is evidence
  /// the detector is wrong about that pattern, not just that this row was.
  highConfidenceOverride Boolean @default(false)

  reviewedByActorId String?
  reviewedAt        DateTime?

  // -- Inventory attributes (Screen 3) -------------------------------------
  /// identity | contact | kyc | financial | transaction | marketing | behavioural | support
  category String?
  /// high | medium | low — sensitivity tier, distinct from detector confidence.
  sensitivityTier String @default("medium")
  /// FK to the DPO-approved taxonomy. Null is DISPLAYED as a flag, not as an
  /// empty cell: an untagged field is the signal that a purpose case is still
  /// unresolved, and a blank cell reads as "nothing to do here".
  purposeTagId String?
  /// customer | employee | vendor | minor
  dataSubjectType String?
  lastVerified    DateTime?
  /// synced | pending | failed | not_configured
  catalogSyncStatus String @default("not_configured")

  /// True when this scan classified the field differently from the last one.
  /// Drift on an already-trusted field is a different problem from a field
  /// nobody has classified yet, and gets its own treatment.
  driftFlag        Boolean @default(false)
  previousType     String?

  source     DiscoverySource @relation(fields: [sourceId], references: [id])
  purposeTag PurposeTag?     @relation(fields: [purposeTagId], references: [id])

  triageItems   TriageItem[]
  rotCandidate  ROTCandidate?
  duplicatesAsA DuplicatePair[] @relation("DuplicateFieldA")
  duplicatesAsB DuplicatePair[] @relation("DuplicateFieldB")

  @@index([sourceId])
  @@index([confidence])
  @@index([category])
  @@index([purposeTagId])
}

/// Anything awaiting an Admin decision.
///
/// `type` is what keeps the queue tabbed rather than a single feed. Merging a
/// low-confidence classification, a new-PII alert and a ROT candidate into one
/// undifferentiated list is how a queue becomes something nobody opens.
model TriageItem {
  id String @id @default(cuid())

  /// low_confidence | new_pii | rot | duplicate | quarantine
  type String
  /// The record this item is about — a ClassifiedField for most types.
  fieldId String?
  /// For duplicate items, the pair being resolved.
  duplicatePairId String?

  /// high | medium | low
  priority String @default("medium")
  /// open | resolved | dismissed | escalated
  status   String @default("open")

  /// Set when the same underlying record also qualifies for another tab. The
  /// row appears ONCE, in its primary category, with a cross-reference — never
  /// duplicated across tabs.
  crossRefType String?

  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedByActorId String?

  field         ClassifiedField? @relation(fields: [fieldId], references: [id])
  duplicatePair DuplicatePair?   @relation(fields: [duplicatePairId], references: [id])

  @@index([type, status])
  @@index([createdAt])
}

/// A candidate duplicate pair.
///
/// `keep_both` is a first-class resolution, not a fallback. Two legitimately
/// different records that merely look similar are a realistic match failure,
/// and merging them is not reversible in any useful sense — so the UI must not
/// make merge the path of least resistance.
model DuplicatePair {
  id        String @id @default(cuid())
  fieldAId  String
  fieldBId  String

  /// 0-100.
  similarityScore Int
  /// unresolved | merge | keep_both | keep_one
  resolution      String  @default("unresolved")
  /// When resolution is keep_one, which one survives.
  keptFieldId     String?

  resolvedAt        DateTime?
  resolvedByActorId String?
  createdAt         DateTime @default(now())

  fieldA ClassifiedField @relation("DuplicateFieldA", fields: [fieldAId], references: [id])
  fieldB ClassifiedField @relation("DuplicateFieldB", fields: [fieldBId], references: [id])

  triageItems TriageItem[]
  mergeSteps  MergeStep[]

  @@index([resolution])
}

/// Per-system confirmation that a merge actually landed.
///
/// A merge touches references in every connected system, and those confirm
/// separately. Same three-state discipline as erasure and revocation: the merge
/// is not "done" because the primary store returned success.
model MergeStep {
  id              String @id @default(cuid())
  duplicatePairId String
  systemId        String

  /// pending | partial | verified | failed
  status        String @default("pending")
  referencesUpdated Int @default(0)
  confirmedAt   DateTime?
  failureCode   String?
  failureDetail String?

  duplicatePair DuplicatePair   @relation(fields: [duplicatePairId], references: [id])
  system        ConnectedSystem @relation(fields: [systemId], references: [id])

  @@index([duplicatePairId])
}

/// Redundant, obsolete or trivial data.
model ROTCandidate {
  id      String @id @default(cuid())
  fieldId String @unique

  /// 0-100. Low score plus old last-accessed is the case for removal.
  businessValueScore Int
  lastAccessed       DateTime?
  reason             String

  /// unresolved | quarantine | delete | retain
  resolution        String  @default("unresolved")
  resolutionReason  String?
  resolvedAt        DateTime?
  resolvedByActorId String?

  field ClassifiedField @relation(fields: [fieldId], references: [id])

  @@index([resolution])
}

model DiscoverySource {
  id   String @id @default(cuid())
  name String @unique
  /// database | cloud_storage | saas | file_share | other
  kind String @default("database")

  /// untested | connected | connected_no_data | failed
  connectionState String  @default("untested")
  connectionHint  String?
  failureCode     String?
  failureDetail   String?

  /// Discovery SCOPE approval belongs to the DPO, not Admin. A source Admin can
  /// connect is not automatically a source Admin may scan.
  dpoApprovedForScanning Boolean @default(false)

  /// Set for "other / custom" sources, which usually cannot be verified
  /// automatically and get routed to manual verification later.
  requiresManualVerification Boolean @default(false)

  // -- Purpose role flags ---------------------------------------------------
  // The SAME registry serves two purposes. These flags are what Connected
  // Systems filters on: a system can be a scan target, an execution target, or
  // both. Connected Systems is the execution-target-scoped view of this list.
  /// Available to Data Discovery as a scan target.
  availableAsScanTarget Boolean @default(true)
  /// Available to Request execution as an execution (deletion/access) target.
  availableAsExecutionTarget Boolean @default(false)
  /// The execution facet of this same real system, when it is an execution
  /// target. One system, one record — this is a link between two purpose facets
  /// of one registry entry, not two separate systems.
  connectedSystemId String?          @unique
  connectedSystem   ConnectedSystem? @relation(fields: [connectedSystemId], references: [id])

  /// pending | running | scanned | partial | failed
  scanStatus                String    @default("pending")
  lastScanned               DateTime?
  estimatedDurationMinutes  Int?
  classificationSummary     String?
  scanFailureDetail         String?

  // -- Scan configuration (Screen 4, Scan Config tab) ----------------------
  // Read-only until dpoApprovedForScanning: scope approval is the DPO's, and a
  // schedule Admin can set on an unapproved source is a scan Admin can run on
  // one.
  /// on_demand | daily | weekly | monthly
  scanSchedule String @default("on_demand")
  /// shallow | standard | deep
  scanDepth    String @default("standard")
  /// Off-peak window as "HH:MM-HH:MM". Surfaced prominently rather than hidden
  /// behind an "advanced" section, because the sources that most need it are
  /// the large legacy ones where a daytime deep scan is genuinely disruptive.
  offPeakWindow String?
  /// Which business unit or legal entity this source belongs to. A filter
  /// dimension on the inventory, never a separate inventory.
  entityId String?

  fields    ClassifiedField[]
  scanRuns  ScanRun[]
  ropaSuggestions RopaSuggestion[]
  flowNodes DataFlowNode[]
}

/// One scan execution. Kept as history rather than overwriting the source's
/// status, so a failure survives the run that produced it — a failure that
/// disappears when the run ends cannot be investigated afterwards.
model ScanRun {
  id       String @id @default(cuid())
  sourceId String

  /// running | completed | partial | failed
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// Per-stage progress for the Live Progress tab: JSON array of
  /// { stage, state, detail }. Real stages, not a spinner.
  stagesJson String @default("[]")

  fieldsFound    Int @default(0)
  fieldsNew      Int @default(0)
  fieldsChanged  Int @default(0)
  fieldsRemoved  Int @default(0)

  /// Which stage broke, and the three-part detail Admin needs to act.
  failureStage  String?
  failureReason String?
  failureAction String?

  source DiscoverySource @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([status])
}

/// A node on the flow map. Generated from Sources, Integrations and Request
/// channels — Admin does not draw these.
model DataFlowNode {
  id    String @id @default(cuid())
  label String
  /// source | system | processor | touchpoint
  nodeType String @default("system")
  subtitle String?
  refHref  String?
  entityId String?

  /// Typed links to the record this node stands for, so the flow map can render
  /// the real profile inline instead of only linking out. Nullable: "touchpoint"
  /// (and some "system") nodes have no backing record and stay refHref-only.
  sourceRefId    String?
  processorRefId String?
  source    DiscoverySource? @relation(fields: [sourceRefId], references: [id])
  processor DataProcessor?   @relation(fields: [processorRefId], references: [id])

  outgoing DataFlowConnection[] @relation("FlowFrom")
  incoming DataFlowConnection[] @relation("FlowTo")

  @@index([sourceRefId])
  @@index([processorRefId])
}

/// An edge. A connection with no purpose and no linked DPIA is `undisclosed` —
/// the thing the flow map exists to surface — and renders as a red dashed edge.
model DataFlowConnection {
  id                 String @id @default(cuid())
  fromNodeId         String
  toNodeId           String
  dataCategoriesJson String @default("[]")

  purposeTagId String?
  dpiaRef      String?
  processorId  String?
  /// documented | undisclosed
  status String @default("documented")
  manual Boolean @default(false)

  from       DataFlowNode @relation("FlowFrom", fields: [fromNodeId], references: [id])
  to         DataFlowNode @relation("FlowTo", fields: [toNodeId], references: [id])
  purposeTag PurposeTag?  @relation(fields: [purposeTagId], references: [id])

  @@index([status])
}

model Entity {
  id                String  @id @default(cuid())
  name              String
  /// legal_entity | business_unit
  kind              String
  hierarchyParentId String?

  /// not_assessed | sdf | not_sdf
  sdfStatus      String  @default("not_assessed")
  sdfHistoryJson String  @default("[]")
  mergerPending  Boolean @default(false)

  /// dedicated_dpo | combined_admin_dpo — governance is set PER ENTITY (each legal
  /// entity is its own Data Fiduciary). Null = not yet answered during onboarding,
  /// which drives the non-dismissible incomplete-state banner.
  governanceStructure String?

  userMappings EntityUserMapping[]
  notices      Notice[]
  activities   ProcessingActivity[]
  roleAssignments RoleAssignment[]
}

model EntityUserMapping {
  id       String @id @default(cuid())
  userName String
  entityId String
  /// single | cross
  accessScope String @default("single")
  additionalEntitiesJson String @default("[]")
  justification          String?

  entity Entity @relation(fields: [entityId], references: [id])

  @@index([entityId])
}

model ProtectionRuleScope {
  id     String @id @default(cuid())
  ruleId String @unique
  systemsJson String @default("[]")
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model ProtectionRuleException {
  id      String @id @default(cuid())
  ruleId  String
  process String
  narrowedScope String
  /// requested | approved
  status     String   @default("approved")
  approvedBy String?
  approvedAt DateTime @default(now())

  @@index([ruleId])
}

/// A role Admin can grant and edit.
///
/// `baselineSnapshotJson` is the CISO-approved definition of what this role is
/// permitted to reach. `permissionsJson` is what it currently grants. When the
/// two diverge, that is DRIFT: Admin can edit the role within the baseline, but
/// widening it beyond the baseline is a governance change, not a technical one,
/// and the guards route it to an escalation.
/// The single Role entity for the whole product — surfaced read-only in Approved
/// Policy and fully in Identity & Access, never duplicated. Historically the RBAC
/// matrix row; extended with the capability model, lifecycle status and role type
/// the Identity & Access module needs.
model RBACRole {
  id          String @id @default(cuid())
  name        String @unique
  description String @default("")
  systemId    String?

  /// system | custom. System roles are DPO/CISO-authored and locked to Admin
  /// (same treatment as Approved Policy); custom roles are Admin-composed.
  roleType String @default("system")
  /// approved | draft | pending_dpo_approval — the composition/ratification
  /// lifecycle. Only approved (and all system) roles are assignable.
  status   String @default("approved")

  /// JSON of the capability model: [{ module, action, sensitivity }]. The
  /// plain-permission list below is kept for the existing RBAC-matrix screens.
  capabilitiesJson String @default("[]")
  createdBy        String?
  /// True when ratified under combined_admin_dpo governance. System-computed; a
  /// permanent historical marker, never relabelled on a later governance change.
  selfApproved     Boolean @default(false)

  /// JSON string[] of permissions currently granted by this role.
  permissionsJson String
  /// JSON string[] — the CISO-approved ceiling. Read-only to Admin.
  baselineSnapshotJson String
  /// JSON string[] of data categories the baseline says this role may reach.
  baselineCategoriesJson String @default("[]")

  /// True for the least-privilege starting points offered by the Provisioning
  /// Panel.
  isTemplate       Boolean @default(false)
  /// approved_by / approved_at for the ratified role (system, or approved custom).
  baselineApprovedBy String @default("A. Khan")
  baselineApprovedAt DateTime @default(now())
  /// When Admin last saved / reviewed this role. Drives the RBAC matrix's
  /// "Last reviewed" column; updated automatically on every role save.
  lastReviewedAt   DateTime?

  grants AccessGrant[]
  provisioningRequests ProvisioningRequest[]
  assignments RoleAssignment[]

  @@index([roleType])
  @@index([status])
}

/// A role granted to a person within a Fiduciary, scoped to systems. The
/// evidentiary record for a Rule 6 audit: it carries the justification and a
/// snapshot of the role's capabilities AT GRANT TIME, so later drift is
/// measurable against what was actually approved rather than against today's role.
model RoleAssignment {
  id       String @id @default(cuid())
  roleId   String
  /// Person the role is granted to (free text / InternalUser name for the demo).
  userName String
  userId   String?
  /// The Fiduciary (Entity) the assignment sits within.
  entityId String?

  /// JSON string[] of systems the grant reaches (the scope).
  scopeSystemsJson String @default("[]")
  justification    String
  grantedAt        DateTime @default(now())
  /// Capabilities captured at grant time — the baseline drift is measured against.
  baselineSnapshotJson String @default("[]")

  /// active | expired | revoked
  status String @default("active")

  /// Per-system provisioning grid: [{ system, status: pending|granted|failed, detail? }]
  /// and the rolled-up state, so a partial failure is never shown as success.
  provisioningJson   String @default("[]")
  /// granted | partial | failed | pending
  provisioningStatus String @default("granted")

  role   RBACRole @relation(fields: [roleId], references: [id])
  entity Entity?  @relation(fields: [entityId], references: [id])
  drift  DriftRecord[]

  @@index([roleId])
  @@index([status])
}

/// One detected deviation of an assignment's current capabilities from its
/// approved baseline. Every drift ends in a recorded decision — detection alone
/// is not the deliverable; resolution is.
model DriftRecord {
  id           String @id @default(cuid())
  assignmentId String

  detectedAt           DateTime @default(now())
  baselineSnapshotJson String   @default("[]")
  currentSnapshotJson  String   @default("[]")
  /// critical | minor — computed from the sensitivity of what changed.
  severity   String @default("minor")

  /// corrected | retroactively_approved | unresolved
  resolution String @default("unresolved")
  resolvedBy String?
  resolvedAt DateTime?
  /// True when a retroactive approval was recorded under combined_admin_dpo
  /// governance. System-computed; permanent historical marker.
  selfApproved Boolean @default(false)

  /// Whether the change could be traced to a source; drives the review drawer's
  /// change-trace line vs. the "source unclear — flag for investigation" state.
  traceable   Boolean @default(true)
  changeTrace String?

  assignment RoleAssignment @relation(fields: [assignmentId], references: [id])

  @@index([severity])
  @@index([resolution])
}

/// A pending or completed request to grant access, before any grant exists.
///
/// This is the queue the Provisioning screen works from. A grant is not created
/// the moment a request arrives — it is created when Admin applies a
/// least-privilege template (and, for the exception path, records a
/// justification for broadening beyond it) and executes the multi-system grant.
/// Per-system execution state lives in `systemsJson`, giving the same
/// three-state (pending / granted / failed) shape as Request execution.
model ProvisioningRequest {
  id            String @id @default(cuid())
  requesterName String
  requesterDept String @default("")
  /// hr_sync | manual
  source        String
  /// pending | granted | failed
  status        String @default("pending")
  requestedAt   DateTime @default(now())

  /// The role the requester asked for (matched to a least-privilege template).
  roleId        String?
  roleRequested String

  /// JSON: [{ system, level, status: pending|granted|failed, reason? }] — the
  /// per-system execution grid, written as the grant is carried out.
  systemsJson   String @default("[]")

  /// Set only when the grant was broadened beyond the template default. Its
  /// presence is what makes the exception visible after the fact.
  broadenedJustification String?

  executedAt    DateTime?
  executedByActorId String?

  role RBACRole? @relation(fields: [roleId], references: [id])

  @@index([status])
}

/// Singleton org-level configuration (id is always "org"). Holds the governance
/// structure that decides how approvals route: a dedicated DPO, or a combined
/// Admin+DPO where the same person reviews their own requests (recorded as
/// self-approved, never skipped).
model OrgSettings {
  id String @id @default("org")
  /// dedicated_dpo | combined_admin_dpo — the ORG-LEVEL routing used by the
  /// approval flow. Onboarding sets governance per entity (Entity.governanceStructure)
  /// and mirrors it here: combined if any entity is combined, else dedicated.
  governanceStructure String @default("dedicated_dpo")

  // -- Onboarding ----------------------------------------------------------
  name     String?
  /// startup | mid_market | enterprise
  sizeTier String?
  /// Explicitly a single-user org (counts toward is_fully_configured).
  singleUser Boolean @default(false)
  /// One-time "we set up your org" banner (Screen 3) — dismissed forever once true.
  provisionBannerDismissed Boolean @default(false)
  /// Getting Started checklist card dismissal.
  gettingStartedDismissed  Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?
}
